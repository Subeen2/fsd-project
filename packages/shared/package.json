{
  "name": "@fsd/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared utilities and types",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "devDependencies": {
    "@fsd/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
